# Same-origin /api (recommended: custom domain maps /api -> API Gateway).
# If you use a dedicated api.<portal> host, set e.g. https://api.vw-baev.de/api
VITE_API_BASE=/api

# Comma-separated allowlist of origins that may receive the browser after login.
VITE_ALLOWED_AUTH_ORIGINS=https://kc.gateway-vw.de:8443

# Set to false on day one after Verimi is removed from all realms.
VITE_VERIMI_AVAILABLE=true

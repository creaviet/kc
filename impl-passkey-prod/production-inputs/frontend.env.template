# Copy to frontend.env, then copy to frontend/.env for each portal build.
# Recommended when API Gateway maps /api on the portal domain:
VITE_API_BASE=/api

# If you use api.<portal>/api instead, use e.g.:
# VITE_API_BASE=https://api.vw-baev.de/api

VITE_ALLOWED_AUTH_ORIGINS=https://kc.gateway-vw.de:8443

# true while Verimi is active. Set false after Verimi shutdown.
VITE_VERIMI_AVAILABLE=true

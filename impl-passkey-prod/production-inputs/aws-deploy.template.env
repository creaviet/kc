# Copy to aws-deploy.env. Do not paste real cookie keys into chat.
AWS_REGION=eu-central-1
STAGE=prod
TABLE_SUFFIX=prod

# ARN of the AWS Secrets Manager secret created from vps/generated/portal-secrets.json
SECRETS_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:REPLACE_ACCOUNT_ID:secret:REPLACE_SECRET_NAME-REPLACE_SUFFIX

# Active cookie key id. The JSON must contain this id and a 32-byte base64url value.
COOKIE_ACTIVE_KEY_ID=REPLACE_KEY_ID
COOKIE_ENCRYPTION_KEYS_JSON={"REPLACE_KEY_ID":"REPLACE_BASE64URL_AES256_KEY"}

KC_PUBLIC_URL=https://kc.gateway-vw.de:8443
ALLOWED_AUTH_ORIGINS=https://kc.gateway-vw.de:8443

# Optional. Leave empty if you do not attach a WAF Web ACL.
WAF_WEB_ACL_ARN=

# Optional. Leave empty unless you use an SNS topic for alarms.
ALARM_SNS_TOPIC_ARN=

# Local IONOS-VPS mock configuration for backend/.env.mock.
# The mock uses client_id=portal-spa and client_secret=dev-secret.

KC_BASE_URL=http://localhost:9443
PHASE=B
DEV_PORTAL_HOST=vw-baev.de
PORTALS_JSON={"vw-baev.de":{"realm":"vw-beav","clientId":"portal-spa","clientSecret":"dev-secret","redirectUri":"http://localhost:5173/api/auth/callback"}}
STORE=memory
INSECURE_COOKIES=true
PORT=3001

# Generate with: node ops/generate-keys.js
SESSION_ENC_KEY_B64U=REPLACE_WITH_32_BYTE_BASE64URL_KEY
TX_ENC_KEY_B64U=REPLACE_WITH_32_BYTE_BASE64URL_KEY

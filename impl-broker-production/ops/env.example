# ---------------------------------------------------------------------------
# Production BFF configuration template.
#
# This folder contains no local/mock/emulated mode. The Lambda refuses to start
# if INSECURE_COOKIES, ALLOW_INSECURE_OIDC, DEV_PORTAL_HOST, a memory store,
# a non-HTTPS Keycloak URL, or fewer/more than 9 portals are configured.
#
# Secrets belong in Secrets Manager, not in git. This file is only a checklist.
# ---------------------------------------------------------------------------

# Server-side Keycloak URL: Customer Portal, JWKS, Account API.
KC_BASE_URL=https://kc.gateway-vw.de:8443

# Browser-facing Keycloak URL: authorize/logout URLs and the `iss` claim.
# Keycloak hostname v2 must emit exactly this value and Lambda must resolve it.
KC_PUBLIC_URL=https://kc.gateway-vw.de:8443

# Phase B = Verimi brokered + passkey bootstrap. Phase C = passkey only.
PHASE=B

# Exactly 9 portals. clientSecret must be >= 32 characters and match the
# Keycloak client secret stored in the realm vault file <realm>_portal-spa-secret.
PORTALS_JSON={"vw-baev.de":{"realm":"vw-beav","clientId":"portal-spa","clientSecret":"REPLACE_WITH_32_PLUS_CHARS","redirectUri":"https://vw-baev.de/api/auth/callback"},"ltkv.de":{"realm":"vw-ltkv","clientId":"portal-spa","clientSecret":"REPLACE_WITH_32_PLUS_CHARS","redirectUri":"https://ltkv.de/api/auth/callback"}}

# 256-bit keys from ops/generate-keys.js (three independent keys).
SESSION_ENC_KEY_B64U=REPLACE_WITH_32_BYTE_BASE64URL
TX_ENC_KEY_B64U=REPLACE_WITH_32_BYTE_BASE64URL
ENROLLED_ENC_KEY_B64U=REPLACE_WITH_32_BYTE_BASE64URL

# Previous keys for zero-downtime rotation. On the first deploy, copy the
# current value into each previous key.
SESSION_ENC_KEY_PREVIOUS_B64U=REPLACE_WITH_32_BYTE_BASE64URL
TX_ENC_KEY_PREVIOUS_B64U=REPLACE_WITH_32_BYTE_BASE64URL
ENROLLED_ENC_KEY_PREVIOUS_B64U=REPLACE_WITH_32_BYTE_BASE64URL

# Persistence (DynamoDB only)
TABLE_NAME=passkey-migration
SESSION_TABLE_NAME=passkey-migration-sessions
AWS_REGION=eu-central-1
EXPECTED_PORTAL_COUNT=9

# Lifetimes (seconds)
SESSION_TTL_SECONDS=28800
TX_TTL_SECONDS=600
ENROLLED_COOKIE_TTL_SECONDS=31536000

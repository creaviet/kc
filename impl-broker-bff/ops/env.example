# ---------------------------------------------------------------------------
# BFF configuration — copy to .env for local dev, or to Lambda env in prod.
# Secrets belong in SSM Parameter Store / Secrets Manager, not in git.
# ---------------------------------------------------------------------------

# Server-side Keycloak URL: token endpoint, JWKS, Account API.
KC_BASE_URL=https://kc.gateway-vw.de:8443

# Browser-facing Keycloak URL: authorize/logout URLs and the `iss` claim.
# Keycloak hostname v2 must emit exactly this value.
KC_PUBLIC_URL=https://kc.gateway-vw.de:8443

# Phase B = Verimi brokered + passkey bootstrap. Phase C = passkey only.
PHASE=B

# Host -> realm/client configuration. One realm per portal.
# The client_secret values must match the `secret` in each realm's client.
PORTALS_JSON={"vw-baev.de":{"realm":"vw-beav","clientId":"portal-spa","clientSecret":"REPLACE_ME","redirectUri":"https://vw-baev.de/api/auth/callback"},"ltkv.de":{"realm":"vw-ltkv","clientId":"portal-spa","clientSecret":"REPLACE_ME","redirectUri":"https://ltkv.de/api/auth/callback"}}

# 256-bit keys from ops/generate-keys.js (three independent keys).
SESSION_ENC_KEY_B64U=REPLACE_ME
TX_ENC_KEY_B64U=REPLACE_ME
ENROLLED_ENC_KEY_B64U=REPLACE_ME

# Previous keys for zero-downtime rotation. On the first deploy, copy the
# current value into each previous key. During rotation, set previous=old,
# current=new, deploy twice, then remove/keep previous according to your policy.
SESSION_ENC_KEY_PREVIOUS_B64U=REPLACE_ME
TX_ENC_KEY_PREVIOUS_B64U=REPLACE_ME
ENROLLED_ENC_KEY_PREVIOUS_B64U=REPLACE_ME

# Persistence
STORE=dynamodb                    # dynamodb | memory
TABLE_NAME=passkey-migration
SESSION_TABLE_NAME=passkey-migration-sessions
AWS_REGION=eu-central-1
EXPECTED_PORTAL_COUNT=9

# Lifetimes (seconds)
SESSION_TTL_SECONDS=28800         # 8 h portal session
TX_TTL_SECONDS=600                # 10 min for the OIDC redirect round-trip
ENROLLED_COOKIE_TTL_SECONDS=31536000  # 1 year browser-local "has passkey" hint

# Local development ONLY. Never set in production.
# INSECURE_COOKIES=true
# DEV_PORTAL_HOST=vw-baev.de
# PORT=3001
